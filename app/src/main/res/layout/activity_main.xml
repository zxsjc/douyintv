<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面（2.39 单行导航版）
  ========================
    · 顶部信息条（频道标题 + 计数 + 提示）
    · 单行导航：频道「关注 / 推荐」+ 入口「我的关注 / 搜索 / 设置 / 登录」，
      全部中文文字、无图标，由 MainActivity 动态填充
    · 内容区：视频网格 + 焦点信息栏 + 占位三态
  已删除：左侧纵向图标导航栏（sidebar 及其 5 个图标项）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical">

    <!-- 顶部信息条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/tv_content_padding"
        android:paddingRight="@dimen/tv_content_padding"
        android:paddingTop="@dimen/space_l"
        android:paddingBottom="@dimen/space_s">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关注"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_section_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_m"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 单行导航（频道 + 入口，内容由代码填充） -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/tv_content_padding"
        android:paddingRight="@dimen/tv_content_padding"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="@dimen/tv_content_padding"
        android:paddingRight="@dimen/tv_content_padding"
        android:paddingBottom="@dimen/tv_content_padding">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/infobar_height"
            android:scrollbars="none" />

        <!-- 焦点信息栏（卡片纯封面，标题/作者只在此显示） -->
        <LinearLayout
            android:id="@+id/infobar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/infobar_height"
            android:layout_gravity="bottom"
            android:background="@color/scrim_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m">

            <TextView
                android:id="@+id/tvInfoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/infobar_title_size" />

            <TextView
                android:id="@+id/tvInfoMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/infobar_meta_size" />
        </LinearLayout>

        <!-- 占位：加载中 / 空 / 失败 三态共用 -->
        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="@dimen/tv_placeholder_icon"
                android:layout_height="@dimen/tv_placeholder_icon"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/tv_placeholder_text" />

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/tv_btn_height"
                android:layout_marginTop="@dimen/tv_placeholder_btn_gap"
                android:background="@drawable/focus_chip"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="@dimen/tv_btn_min_width"
                android:paddingLeft="@dimen/tv_btn_padding_h"
                android:paddingRight="@dimen/tv_btn_padding_h"
                android:text="重试"
                android:textColor="@color/btn_text"
                android:textSize="@dimen/tv_btn_text_size"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
