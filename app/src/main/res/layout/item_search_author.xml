<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索结果里的作者卡片（2.40）
  ==========================
  搜索页从「搜视频」改成「搜作者」后，一张卡就是一位作者：
  头像 + 昵称 + 粉丝数/认证 + 简介，右侧一句「看作品」。
  一列一张（占满结果区宽度）—— 昵称动辄七八个字，两列会把名字截成
  「Stephen C…」，电视上反而看不出是谁。
  OK 键 = 进作者作品页；焦点态沿用统一的 focus_card 描边。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tv_card_margin"
    android:background="@drawable/focus_card"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_m">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_section_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvSig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_l"
        android:text="看作品"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_body" />

</LinearLayout>
