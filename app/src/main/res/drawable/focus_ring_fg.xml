<?xml version="1.0" encoding="utf-8"?>
<!--
  焦点描边「前景层」
  ==================
  卡片封面是 match_parent 的 ImageView，会把 background 里的焦点描边整块盖住
  （历史/收藏列表因此"看不到焦点在哪"）。
  把描边画成 FrameLayout 的 foreground，并 duplicateParentState 跟随父项焦点态，
  这样焦点环永远浮在封面上方。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/card_radius" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
