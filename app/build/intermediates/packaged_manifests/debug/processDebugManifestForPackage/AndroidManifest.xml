<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.douyintv"
    android:versionCode="140"
    android:versionName="2.40" >

    <!--
 ijkplayer-arm64 的 aar 声明 minSdk 21，强制放行：
         arm64 设备必然 >=21，低版本走 armeabi-v7a
    -->
    <uses-sdk
        android:minSdkVersion="17"
        android:targetSdkVersion="26" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台播放服务（Android 8+ 必须显式声明，否则 startForegroundService 抛 SecurityException） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
         在线更新：Android 8+ 必须有它，否则 startActivity(APK) 只会静默失败，
         系统安装器根本不弹（老版本缺这一条，是「更新下载完却装不上」的主因）
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name="com.example.douyintv.App"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:banner="@drawable/tv_banner"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.example.douyintv.MainActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.douyintv.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.example.douyintv.PlayerActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 搜索页：热搜榜 + 关键词检索（独立页，返回键回主界面） -->
        <activity
            android:name="com.example.douyintv.SearchActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.example.douyintv.HotActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.example.douyintv.LoginActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name="com.example.douyintv.FollowListActivity"
            android:exported="false" />
        <activity
            android:name="com.example.douyintv.AuthorActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!--
             评论改为右侧悬浮小窗（CommentDialogFragment），
             不再需要独立 Activity —— 跳转会暂停视频，体验差。
        -->


        <!--
             黑方块来源诊断页：纯白底 + 可选 SurfaceView 合成测试。
             入口在设置页，不参与正常业务流程。
        -->
        <activity
            android:name="com.example.douyintv.WhiteTestActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!--
             接口自检页：实测分类/搜索候选接口，结果直接显示在屏幕上。
             纯诊断用途，入口在设置页。
        -->
        <activity
            android:name="com.example.douyintv.ApiProbeActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <!-- 关于页：作者 / 主页二维码 / 签名校验（设置 -> 关于） -->
        <activity
            android:name="com.example.douyintv.AboutActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name="com.example.douyintv.PlayService"
            android:exported="false" />

        <!-- 在线更新安装：文件 URI 必须走 FileProvider（targetSdk 26 禁止裸 file://） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.douyintv.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>