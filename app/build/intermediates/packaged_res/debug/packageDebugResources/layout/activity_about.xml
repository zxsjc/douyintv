<?xml version="1.0" encoding="utf-8"?>
<!--
  关于 Dtv（二级页）
  =================
  只保留：版本号 + 签名指纹（防篡改核对用）。
  作者名、主页二维码以及相关提示文案已移除。
  风格与设置页保持一致（bg_root / focus_chip / text_* 同源）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical"
    android:padding="@dimen/tv_content_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="关于 Dtv"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tv_section_title_size"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="当前版本"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tv_section_title_size"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="签名指纹（SHA-256）"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/tvSig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/tvSigBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@color/scrim_strong"
        android:padding="@dimen/space_m"
        android:text="⚠ 签名指纹与当前安装版本不一致，请通过官方更新渠道重新安装。"
        android:textColor="@color/accent_error"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dtv 是免费客户端，更新请走应用内「检查更新」。"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption" />

</LinearLayout>
