<?xml version="1.0" encoding="utf-8"?>
<!--
  视频卡片专用背景（★ 修复「焦点框线显示异常」）
  ================================================
  旧版卡片背景用 @drawable/focus_card：focused 态同时画
    ① 3dp 柔光外圈（focus_halo_inset 虽为 0，但 stroke 仍在原位叠加）
    ② 2dp 主体白描边
  再加上封面 FrameLayout 的 foreground=@drawable/focus_ring_fg 又画一层 3dp 描边，
  于是同一张卡有【三层描边】叠在一起 → 用户看到的「框线粗细不一 / 异常」。

  修复：卡片焦点态只负责「提亮底色」，描边全部交给唯一一层 foreground
  (@drawable/focus_ring_fg，统一 2dp)。全屏只有一条干净的焦点框。
  本文件单独给视频卡片用，不影响共用 focus_card 的评论/搜索/关注作者等页面。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_hi" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
